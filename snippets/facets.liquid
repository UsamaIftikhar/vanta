<form class='facets' method='get' action='{{ action }}'>
  {% if request.page_type == 'search' -%}
    <input type='hidden' name='q' value='{{ search.terms | escape }}'
    ><input type='hidden' name='options[prefix]' value='last'>
  {%- endif %}
  {% if request.page_type == 'collection' %}
    <nav class='category-filter' aria-label='Shop by category'>
      <span class='category-filter__label'>Category</span>
      <ul role='list'>
        <li>
          <a
            href='{{ routes.all_products_collection_url }}'
            {% if collection.handle == 'all' %}
              aria-current='page'
            {% endif %}
          >All shoes</a>
        </li>
        {% for category in collections limit: 8 %}
          {% unless category.handle == 'all' or category.handle == 'frontpage' %}
            <li>
              <a
                href='{{ category.url }}'
                {% if collection.handle == category.handle %}
                  aria-current='page'
                {% endif %}
              >{{ category.title | escape }}</a>
            </li>
          {% endunless %}
        {% endfor %}
      </ul>
    </nav>
  {% endif %}
  <div class='filter-row'>
    {% for filter in results.filters %}
      <details>
        <summary>
          {{ filter.label | escape -}}
          {%- if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}
        </summary>
        <div class='filter-panel'>
          {% case filter.type -%}
            {%- when 'boolean', 'list' -%}
              {%- for value in filter.values -%}
                {%- assign filter_id = 'Filter-' | append: filter.param_name | handle | append: '-' | append: forloop.index -%}
                <label class='check-label' for='{{ filter_id }}'>
                  <input
                    id='{{ filter_id }}'
                    type='checkbox'
                    name='{{ value.param_name }}'
                    value='{{ value.value | escape }}'
                    {% if value.active %}
                      checked
                    {% elsif value.count == 0 %}
                      disabled
                    {% endif %}
                  >
                  {{- value.label | escape }} ({{ value.count }})</label
                >
              {%- endfor -%}
            {%- when 'price_range' -%}
              {%- assign minimum_id = 'Filter-' | append: filter.min_value.param_name | handle -%}
              {%- assign maximum_id = 'Filter-' | append: filter.max_value.param_name | handle -%}
              <label for='{{ minimum_id }}'>
                {{- filter.min_value.param_name | split: '.' | last -}}
              </label>
              <input
                  id='{{ minimum_id }}'
                  type='number'
                  name='{{ filter.min_value.param_name }}'
                  min='0'
                  step='0.01'
                  {% if filter.min_value.value %}
                    value='{{ filter.min_value.value | divided_by: 100.0 }}'
                  {% endif %}
                  placeholder='0'>
              <label for='{{ maximum_id }}'>
                {{- filter.max_value.param_name | split: '.' | last -}}
              </label>
              <input
                  id='{{ maximum_id }}'
                  type='number'
                  name='{{ filter.max_value.param_name }}'
                  min='0'
                  step='0.01'
                  max='{{ filter.range_max | divided_by: 100.0 }}'
                  {% if filter.max_value.value %}
                    value='{{ filter.max_value.value | divided_by: 100.0 }}'
                  {% endif %}
                  placeholder='{{ filter.range_max | divided_by: 100.0 }}'>
          {%- endcase %}
        </div>
      </details>
    {% endfor %}
    <label for='SortBy-{{ results.id | default: request.page_type }}'>{{ 'general.sort' | t }}</label>
      <select id='SortBy-{{ results.id | default: request.page_type }}' name='sort_by'>
        {% assign current_sort = results.sort_by | default: results.default_sort_by -%}
        {%- for option in results.sort_options %}
          <option
            value='{{ option.value }}'
            {% if option.value == current_sort %}
              selected
            {% endif %}
          >
            {{ option.name | escape }}
          </option>
        {% endfor %}
      </select>
    <button type='submit'>{{ 'general.apply' | t }}</button>
  </div>
  <div class='active-filters'>
    {% for filter in results.filters -%}
      {%- for value in filter.active_values -%}
        <a href='{{ value.url_to_remove }}'>{{ value.label | escape }} ×</a>
      {%- endfor -%}
      {%- if filter.type == 'price_range' -%}
        {%- if filter.min_value.value or filter.max_value.value -%}
          <a href='{{ filter.url_to_remove }}'>{{ filter.label | escape }} ×</a>
        {%- endif -%}
      {%- endif -%}
    {%- endfor %}
  </div>
</form>
