{% liquid
  assign image_loading = 'lazy'
  assign priority = 'auto'
  if eager
    assign image_loading = 'eager'
    assign priority = 'high'
  endif
%}
{% if kind == 'hero' %}
  <img
    src='{{ 'vanta-hero-cutout.webp' | asset_url }}'
    srcset='{{ 'vanta-hero-cutout-small.webp' | asset_url }} 960w, {{ 'vanta-hero-cutout.webp' | asset_url }} 1280w'
    sizes='{{ sizes | default: '(min-width: 990px) 58vw, 115vw' }}'
    width='1280'
    height='853'
    alt='Original VANTA performance sneaker in pearl, graphite and acid lime'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--product {{ class }}'
  >
{% elsif kind == 'motion' %}
  <img
    src='{{ 'vanta-motion.jpg' | asset_url }}'
    srcset='{{ 'vanta-motion-small.jpg' | asset_url }} 800w, {{ 'vanta-motion.jpg' | asset_url }} 1536w'
    sizes='{{ sizes | default: '(min-width: 990px) 65vw, 100vw' }}'
    width='1536'
    height='1024'
    alt='Runner moving through monumental concrete architecture in VANTA footwear'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--editorial {{ class }}'
  >
{% elsif kind == 'motion-portrait' %}
  <img
    src='{{ 'vanta-motion-portrait.jpg' | asset_url }}'
    srcset='{{ 'vanta-motion-portrait-small.jpg' | asset_url }} 640w, {{ 'vanta-motion-portrait.jpg' | asset_url }} 819w'
    sizes='{{ sizes | default: '(min-width: 990px) 50vw, 100vw' }}'
    width='819'
    height='1024'
    alt='Runner moving through monumental concrete architecture in VANTA footwear'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--editorial {{ class }}'
  >
{% elsif kind == 'technology' %}
  <img
    src='{{ 'vanta-technology.jpg' | asset_url }}'
    srcset='{{ 'vanta-technology-small.jpg' | asset_url }} 800w, {{ 'vanta-technology.jpg' | asset_url }} 1448w'
    sizes='{{ sizes | default: '(min-width: 990px) 55vw, 100vw' }}'
    width='1448'
    height='1086'
    alt='Macro detail of VANTA engineered knit, support plate and sculpted cushioning'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--technology {{ class }}'
  >
{% elsif kind contains 'category-' %}
  {% assign category_name = kind | remove: 'category-' %}
  {% assign full_image = 'vanta-category-' | append: category_name | append: '.jpg' %}
  {% assign small_image = 'vanta-category-' | append: category_name | append: '-small.jpg' %}
  <img
    src='{{ full_image | asset_url }}'
    srcset='{{ small_image | asset_url }} 510w, {{ full_image | asset_url }} 1122w'
    sizes='{{ sizes | default: "(min-width: 990px) 45vw, 100vw" }}'
    width='1122'
    height='1408'
    alt='VANTA {{ category_name | capitalize }} footwear editorial'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--category {{ class }}'
  >
{% elsif kind contains 'detail-' %}
  {% assign detail_name = kind | remove: 'detail-' %}
  {% assign full_image = 'vanta-detail-' | append: detail_name | append: '.jpg' %}
  {% assign small_image = 'vanta-detail-' | append: detail_name | append: '-small.jpg' %}
  <img
    src='{{ full_image | asset_url }}'
    srcset='{{ small_image | asset_url }} 720w, {{ full_image | asset_url }} 1536w'
    sizes='{{ sizes | default: "(min-width: 990px) 30vw, 85vw" }}'
    width='1536'
    height='1024'
    alt='VANTA footwear {{ detail_name | replace: "-", " " }} detail'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--detail {{ class }}'
  >
{% elsif kind == 'hotspot' %}
  <img
    src='{{ 'vanta-hotspot.jpg' | asset_url }}'
    srcset='{{ 'vanta-hotspot-small.jpg' | asset_url }} 510w, {{ 'vanta-hotspot.jpg' | asset_url }} 1122w'
    sizes='{{ sizes | default: "(min-width: 990px) 55vw, 100vw" }}'
    width='1122'
    height='1408'
    alt='VANTA performance sneaker construction study'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--hotspot {{ class }}'
  >
{% elsif kind == 'editorial' %}
  <img
    src='{{ 'vanta-editorial.jpg' | asset_url }}'
    srcset='{{ 'vanta-editorial-small.jpg' | asset_url }} 480w, {{ 'vanta-editorial.jpg' | asset_url }} 1024w'
    sizes='{{ sizes | default: '(min-width: 990px) 50vw, 100vw' }}'
    width='1024'
    height='1536'
    alt='{{ 'general.demo_alt' | t }}'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--editorial {{ class }}'
  >
{% elsif kind == 'flux' or kind == 'aero' or kind == 'terra' %}
  {% assign full_image = 'vanta-' | append: kind | append: '.jpg' %}
  {% assign small_image = 'vanta-' | append: kind | append: '-small.jpg' %}
  <img
    src='{{ full_image | asset_url }}'
    srcset='{{ small_image | asset_url }} 600w, {{ full_image | asset_url }} 1200w'
    sizes='{{ sizes | default: "(min-width: 990px) 25vw, 50vw" }}'
    width='1200'
    height='1200'
    alt='VANTA {{ kind | capitalize }} — {{ "general.demo_label" | t }}'
    loading='{{ image_loading }}'
    class='demo-image demo-image--product {{ class }}'
  >
{% else %}
  <img
    src='{{ 'vanta-campaign.jpg' | asset_url }}'
    srcset='{{ 'vanta-campaign-small.jpg' | asset_url }} 720w, {{ 'vanta-campaign.jpg' | asset_url }} 1536w'
    sizes='{{ sizes | default: '(min-width: 990px) 50vw, 100vw' }}'
    width='1536'
    height='1024'
    alt='{{ 'general.demo_alt' | t }}'
    loading='{{ image_loading }}'
    fetchpriority='{{ priority }}'
    class='demo-image demo-image--campaign {{ class }}'
  >
{% endif %}
