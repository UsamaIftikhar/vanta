<ul class='menu-list'>
  {% for link in menu.links %}
    {% liquid
      assign is_catalog = false
      if link.url == routes.all_products_collection_url or link.url == routes.collections_url
        assign is_catalog = true
      endif
    %}
    <li>
      {% if link.links != blank or is_catalog %}
        <details>
          <summary>{{ link.title | escape }}</summary>
          <div class='submenu'>
            <a
              href='{{ link.url }}'
              {% if link.current %}
                aria-current='page'
              {% endif %}
            >
              {{- link.title | escape }} ↗</a
            >
            <ul>
              {% if link.links != blank %}
                {% for child in link.links %}
                  <li>
                    <a
                      href='{{ child.url }}'
                      {% if child.current %}
                        aria-current='page'
                      {% endif %}
                    >
                      {{- child.title | escape -}}
                    </a>
                    {%- if child.links != blank %}
                      <ul>
                        {% for grandchild in child.links %}
                          <li>
                            <a
                              href='{{ grandchild.url }}'
                              {% if grandchild.current %}
                                aria-current='page'
                              {% endif %}
                            >
                              {{- grandchild.title | escape -}}
                            </a>
                          </li>
                        {% endfor %}
                      </ul>
                    {% endif %}
                  </li>
                {% endfor %}
              {% else %}
                <li><a href='{{ routes.all_products_collection_url }}'>All shoes</a></li>
                {% for collection in collections limit: 6 %}
                  {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
                    <li><a href='{{ collection.url }}'>{{ collection.title | escape }}</a></li>
                  {% endunless %}
                {% endfor %}
              {% endif %}
            </ul>
          </div>
        </details>
      {% else -%}
        <a
          href='{{ link.url }}'
          {% if link.current %}
            aria-current='page'
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {%- endif %}
    </li>
  {% endfor %}
</ul>
