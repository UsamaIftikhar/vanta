<ul class='menu-list'>
  {% for link in menu.links %}
    <li>
      {% if link.links != blank %}
        <details>
          <summary>{{ link.title | escape }}</summary>
          <div class='submenu'>
            <a
              href='{{ link.url }}'
              {% if link.current %}
                aria-current='page'
              {% endif %}
            >
              {{- link.title | escape }} ↗</a
            >
            <ul>
              {% for child in link.links %}
                <li>
                  <a
                    href='{{ child.url }}'
                    {% if child.current %}
                      aria-current='page'
                    {% endif %}
                  >
                    {{- child.title | escape -}}
                  </a>
                  {%- if child.links != blank %}
                    <ul>
                      {% for grandchild in child.links %}
                        <li>
                          <a
                            href='{{ grandchild.url }}'
                            {% if grandchild.current %}
                              aria-current='page'
                            {% endif %}
                          >
                            {{- grandchild.title | escape -}}
                          </a>
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </li>
              {% endfor %}
            </ul>
          </div>
        </details>
      {% else -%}
        <a
          href='{{ link.url }}'
          {% if link.current %}
            aria-current='page'
          {% endif %}
        >
          {{- link.title | escape -}}
        </a>
      {%- endif %}
    </li>
  {% endfor %}
</ul>
