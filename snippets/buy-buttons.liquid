{% assign form_id = 'ProductForm-' | append: section.id -%}
<product-form>
  {% form 'product', product, id: form_id %}
    <input
      type='hidden'
      name='id'
      value='{{ selected.id }}'
      {% unless selected.available %}
        disabled
      {% endunless %}
    >
    {% if product.selling_plan_groups.size > 0 -%}
      <label for='SellingPlan-{{ section.id }}'>
        {{- product.selling_plan_groups.first.name | escape -}}
      </label>
        <select id='SellingPlan-{{ section.id }}' name='selling_plan'>
          {% unless product.requires_selling_plan %}
            <option value=''>{{ product.title | escape }}</option>
          {% endunless -%}
          {%- for allocation in selected.selling_plan_allocations %}
            <option value='{{ allocation.selling_plan.id }}'>
              {{ allocation.selling_plan.name | escape }} — {{ allocation.price | money }}
            </option>
          {% endfor %}
        </select>
    {%- endif %}
    {% if product.gift_card? and block.settings.recipient %}
      <details>
        <summary>{{ 'general.recipient' | t }}</summary>
        <label class='check-label' for='RecipientControl-{{ section.id }}'>
          <input
            id='RecipientControl-{{ section.id }}'
            type='checkbox'
            name='properties[__shopify_send_gift_card_to_recipient]'
            value='true'
          >
          {{- 'general.recipient' | t -}}
        </label>
        <label for='RecipientEmail-{{ section.id }}'>{{ 'general.recipient_email' | t }}</label>
          <input
            id='RecipientEmail-{{ section.id }}'
            type='email'
            name='properties[Recipient email]'
            autocomplete='email'
            value='{{ form.email | escape }}'>
        <label for='RecipientName-{{ section.id }}'>{{ 'general.recipient_name' | t }}</label>
          <input
            id='RecipientName-{{ section.id }}'
            name='properties[Recipient name]'
            maxlength='255'
            autocomplete='name'
            value='{{ form.name | escape }}'>
        <label for='RecipientMessage-{{ section.id }}'>{{ 'general.recipient_message' | t }}</label>
          <textarea
            id='RecipientMessage-{{ section.id }}'
            name='properties[Message]'
            maxlength='200'
          >{{ form.message | escape }}</textarea>
        <label for='RecipientSendOn-{{ section.id }}'>{{ 'general.send_on' | t }}</label>
          <input
            id='RecipientSendOn-{{ section.id }}'
            type='date'
            name='properties[Send on]'
            value='{{ gift_card.send_on }}'>
        <input type='hidden' name='properties[__shopify_offset]' value='0' data-timezone>
      </details>
    {% endif %}
    <label class='quantity-label' for='Quantity-{{ section.id }}'>{{ 'general.quantity' | t }}</label>
      <input
        id='Quantity-{{ section.id }}'
        type='number'
        name='quantity'
        value='{{ selected.quantity_rule.min | default: 1 }}'
        min='{{ selected.quantity_rule.min | default: 1 }}'
        step='{{ selected.quantity_rule.increment | default: 1 }}'
        {% if selected.quantity_rule.max %}
          max='{{ selected.quantity_rule.max }}'
        {% endif %}>
    <button
      class='button purchase-button'
      type='submit'
      {% unless selected.available %}
        disabled
      {% endunless %}
    >
      {% if selected == blank -%}
        {{- 'general.unavailable' | t -}}
      {%- elsif selected.available -%}
        {{- 'general.add' | t }} ↗
      {%- else -%}
        {{- 'general.sold_out' | t -}}
      {%- endif %}
    </button>
    <p data-form-error role='alert'>{{ form.errors | default_errors }}</p>
    {% if block.settings.dynamic_checkout and selected.available and product.gift_card? == false -%}
      {{- form | payment_button -}}
    {%- endif -%}
    {{- form | payment_terms }}
  {% endform %}
</product-form>
