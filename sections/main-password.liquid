<section class='container password-page'>
  <div>
    <p class='eyebrow'>{{ shop.name | escape }}</p>
    <h1 class='display'>{{ section.settings.heading | escape }}</h1>
    <div class='rte'>{{ shop.password_message }}</div>
    {% form 'storefront_password' %}
      <div role='alert'>{{ form.errors | default_errors }}</div>
      <label for='Password'>{{ 'general.password' | t }}</label
      ><input id='Password' type='password' name='password' autocomplete='current-password' required
      ><button class='button'>{{ 'general.enter' | t }} ↗</button>
    {% endform %}
  </div>
</section>
{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something is moving."
    }
  ]
}
{% endschema %}
