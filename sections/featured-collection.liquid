<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='product-grid' style='--columns:{{ section.settings.columns }}'>
      {% for product in section.settings.collection.products limit: section.settings.limit -%}
        {%- render 'product-card', product: product -%}
      {%- else -%}
        {%- for i in (1..4) %}
          <article class='product-card'>
            {% if settings.demo_images -%}
              {%- render 'demo-image', sizes: '(min-width: 990px) 25vw, 50vw' %}
              <p class='eyebrow'>{{ 'general.demo_label' | t }}</p>
              <h3>VANTA {% cycle 'X1', 'Aero', 'Flux', 'Terra' %}</h3>
            {% else -%}
              {{- 'product-1' | placeholder_svg_tag: 'placeholder' }}
              <h3>{{ 'general.view_product' | t }}</h3>
            {% endif %}
          </article>
        {% endfor -%}
      {%- endfor %}
    </div>
    {% if section.settings.collection -%}
      <a class='text-link' href='{{ section.settings.collection.url }}'>
        {{- 'general.all' | t }}
        {{ section.settings.collection.title | escape }} ↗</a
      >
    {%- endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
