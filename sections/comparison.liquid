<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='table-scroll'>
      <table>
        <caption class='visually-hidden'>
          {{ section.settings.heading | escape }}
        </caption>
        <thead>
          <tr>
            <th scope='col'>{{ section.settings.feature_label | escape }}</th>
            {% for block in section.blocks %}
              <th scope='col' {{ block.shopify_attributes }}>
                {% if block.settings.product -%}
                  <a href='{{ block.settings.product.url }}'>
                    {{- block.settings.product.title | escape -}}
                  </a>
                {%- else -%}
                  {{- block.settings.heading | escape -}}
                {%- endif %}
              </th>
            {% endfor %}
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope='row'>{{ section.settings.row1 | escape }}</th>
            {% for block in section.blocks %}
              <td>{{ block.settings.value1 | escape }}</td>
            {% endfor %}
          </tr>
          <tr>
            <th scope='row'>{{ section.settings.row2 | escape }}</th>
            {% for block in section.blocks %}
              <td>{{ block.settings.value2 | escape }}</td>
            {% endfor %}
          </tr>
          <tr>
            <th scope='row'>{{ section.settings.row3 | escape }}</th>
            {% for block in section.blocks %}
              <td>{{ block.settings.value3 | escape }}</td>
            {% endfor %}
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Product comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "text",
      "id": "feature_label",
      "label": "Feature column",
      "default": "Details"
    },
    {
      "type": "text",
      "id": "row1",
      "label": "Feature 1",
      "default": "Designed for"
    },
    {
      "type": "text",
      "id": "row2",
      "label": "Feature 2",
      "default": "Construction"
    },
    {
      "type": "text",
      "id": "row3",
      "label": "Feature 3",
      "default": "Feel"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product column",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Fallback heading",
          "default": "Product"
        },
        {
          "type": "text",
          "id": "value1",
          "label": "Value 1"
        },
        {
          "type": "text",
          "id": "value2",
          "label": "Value 2"
        },
        {
          "type": "text",
          "id": "value3",
          "label": "Value 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product comparison"
    }
  ]
}
{% endschema %}
