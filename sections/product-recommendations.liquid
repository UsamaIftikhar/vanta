<product-recommendations
  class='container section-space'
  data-url='{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent={{ section.settings.intent }}'
>
  {%- if recommendations.performed -%}
    {%- assign recommendation_count = recommendations.products_count -%}
    {%- assign recommendation_ids = '|' -%}
    {%- capture recommendation_cards -%}
      {%- if recommendation_count > 0 -%}
        {%- for recommended_product in recommendations.products -%}
          {%- assign recommendation_ids = recommendation_ids
            | append: recommended_product.id
            | append: '|'
          -%}
          {%- render 'product-card', product: recommended_product -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if recommendation_count < 4 -%}
        {%- for recommended_product in collections.all.products -%}
          {%- assign recommendation_key = recommended_product.id | prepend: '|' | append: '|' -%}
          {%- unless recommended_product.id == product.id
            or recommendation_ids contains recommendation_key
          -%}
            {%- assign recommendation_count = recommendation_count | plus: 1 -%}
            {%- assign recommendation_ids = recommendation_ids
              | append: recommended_product.id
              | append: '|'
            -%}
            {%- render 'product-card', product: recommended_product -%}
            {%- if recommendation_count == 4 %}{% break %}{% endif -%}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if recommendation_count > 0 -%}
      <div class='section-heading recommendation-heading'>
        <div>
          <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
          <h2>{{ section.settings.heading | escape }}</h2>
        </div>
        <p>{{ section.settings.text | escape }}</p>
      </div>
      <div class='product-grid'>{{ recommendation_cards }}</div>
    {%- endif -%}
  {%- endif -%}
</product-recommendations>
{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Complete the rotation"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "More VANTA silhouettes selected to move with you."
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation type",
      "options": [
        {
          "value": "related",
          "label": "Related"
        },
        {
          "value": "complementary",
          "label": "Complementary"
        }
      ],
      "default": "related"
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}
