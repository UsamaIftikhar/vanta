<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='editorial-grid'>
      {% for block in section.blocks %}
        <figure class='quote' {{ block.shopify_attributes }}>
          <blockquote>{{ block.settings.quote | escape }}</blockquote>
          <figcaption>{{ block.settings.author | escape }}</figcaption>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Verified customer quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Attribution"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials"
    }
  ]
}
{% endschema %}
