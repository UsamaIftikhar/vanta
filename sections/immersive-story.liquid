<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='story-layout'>
      <div class='story-scene'>{% render 'product-scene', motion_kind: 'technology' %}</div>
      <div
        class='story-frames'
        role='region'
        aria-label='{{ section.settings.heading | escape }}'
        tabindex='0'
      >
        {% for block in section.blocks %}
          <article
            class='story-frame'
            data-story-frame
            data-rotation='{{ block.settings.rotation }}'
            data-camera='{{ block.settings.camera }}'
            data-scale='{{ block.settings.scale }}'
            data-position-x='{{ block.settings.position_x }}'
            data-position-y='{{ block.settings.position_y }}'
            {{ block.shopify_attributes }}
          >
            <p class='eyebrow'>0{{ forloop.index }} / {{ section.blocks.size }}</p>
            <p class='story-metric'>{{ block.settings.metric | escape }}</p>
            <h3>{{ block.settings.heading | escape }}</h3>
            <div class='rte'>{{ block.settings.text }}</div>
            {% if block.settings.image -%}
              {%- render 'image', image: block.settings.image -%}
            {%- endif %}
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Immersive product story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "checkbox",
      "id": "demo_model",
      "label": "Use bundled VANTA concept model",
      "default": false,
      "info": "An original stylized demo sneaker. A model URL overrides it."
    },
    {
      "type": "url",
      "id": "model",
      "label": "GLB model URL"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster / fallback image"
    },
    {
      "type": "range",
      "id": "scale",
      "label": "Model scale",
      "min": 50,
      "max": 150,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "rotation",
      "label": "Starting rotation",
      "min": -180,
      "max": 180,
      "step": 5,
      "unit": "deg",
      "default": -20
    },
    {
      "type": "range",
      "id": "camera",
      "label": "Camera distance",
      "min": 2,
      "max": 8,
      "step": 0.5,
      "default": 4
    },
    {
      "type": "range",
      "id": "camera_angle",
      "label": "Camera elevation",
      "min": -40,
      "max": 60,
      "step": 5,
      "unit": "deg",
      "default": 10
    },
    {
      "type": "range",
      "id": "position_x",
      "label": "Horizontal position",
      "min": -100,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "range",
      "id": "position_y",
      "label": "Vertical position",
      "min": -100,
      "max": 100,
      "step": 5,
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "auto_rotate",
      "label": "Auto rotation",
      "default": false
    },
    {
      "type": "range",
      "id": "rotation_speed",
      "label": "Rotation speed",
      "min": 5,
      "max": 30,
      "step": 5,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "pointer",
      "label": "Pointer interaction",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "scroll",
      "label": "Scroll rotation",
      "default": true
    },
    {
      "type": "select",
      "id": "lighting",
      "label": "Lighting",
      "options": [
        {
          "value": "studio",
          "label": "Studio"
        },
        {
          "value": "edge",
          "label": "Edge light"
        }
      ],
      "default": "studio"
    },
    {
      "type": "select",
      "id": "mobile",
      "label": "Mobile behavior",
      "options": [
        {
          "value": "poster",
          "label": "Poster with 3D button"
        },
        {
          "value": "interactive",
          "label": "Load interactive 3D"
        }
      ],
      "default": "poster"
    },
    {
      "type": "select",
      "id": "reduced",
      "label": "Reduced motion",
      "options": [
        {
          "value": "poster",
          "label": "Poster with 3D button"
        },
        {
          "value": "static",
          "label": "Static interactive model"
        }
      ],
      "default": "poster"
    }
  ],
  "blocks": [
    {
      "type": "frame",
      "name": "Story frame",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore new ground."
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>A different perspective on everyday movement.</p>"
        },
        {
          "type": "text",
          "id": "metric",
          "label": "Metric"
        },
        {
          "type": "range",
          "id": "rotation",
          "label": "Rotation",
          "min": -180,
          "max": 180,
          "step": 5,
          "default": 0
        },
        {
          "type": "range",
          "id": "camera",
          "label": "Camera distance",
          "min": 2,
          "max": 8,
          "step": 0.5,
          "default": 4
        },
        {
          "type": "range",
          "id": "scale",
          "label": "Scale",
          "min": 50,
          "max": 150,
          "step": 5,
          "default": 100
        },
        {
          "type": "range",
          "id": "position_x",
          "label": "Horizontal position",
          "min": -100,
          "max": 100,
          "step": 5,
          "default": 0
        },
        {
          "type": "range",
          "id": "position_y",
          "label": "Vertical position",
          "min": -100,
          "max": 100,
          "step": 5,
          "default": 0
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Immersive product story"
    }
  ]
}
{% endschema %}
