<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='split-editorial'>
      <div>{% render 'image', image: section.settings.image, demo: 'motion' %}</div>
      <div>
        <div class='section-heading' data-animate>
          <div>
            <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
            <h2>{{ section.settings.heading | escape }}</h2>
          </div>
          <div class='rte'>{{ section.settings.text }}</div>
        </div>
        {% if section.settings.button_link -%}
          <a class='button' data-magnetic href='{{ section.settings.button_link }}'>
            {{- section.settings.button_label | escape }} ↗</a
          >
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Image and manifesto",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image and manifesto"
    }
  ]
}
{% endschema %}
