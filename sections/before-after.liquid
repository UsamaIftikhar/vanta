<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='comparison-images'>
      <figure>
        {% render 'image', image: section.settings.before %}
        <figcaption>{{ section.settings.before_label | escape }}</figcaption>
      </figure>
      <figure>
        {% render 'image', image: section.settings.after %}
        <figcaption>{{ section.settings.after_label | escape }}</figcaption>
      </figure>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Before and after",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "image_picker",
      "id": "before",
      "label": "Before image"
    },
    {
      "type": "image_picker",
      "id": "after",
      "label": "After image"
    },
    {
      "type": "text",
      "id": "before_label",
      "label": "Before label",
      "default": "Before"
    },
    {
      "type": "text",
      "id": "after_label",
      "label": "After label",
      "default": "After"
    }
  ],
  "presets": [
    {
      "name": "Before and after"
    }
  ]
}
{% endschema %}
