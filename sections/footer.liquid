<footer class='site-footer container section-space'>
  <div class='footer-cta'>
    <div>
      <p class='eyebrow'>{{ section.settings.cta_eyebrow | escape }}</p>
      <h2>{{ section.settings.cta_heading | escape }}</h2>
    </div>
    <a class='button button--light' href='{{ routes.all_products_collection_url }}'>
      {{- section.settings.cta_label | escape }} ↗</a
    >
  </div>

  <div class='footer-top'>
    <div class='footer-intro'>
      <a class='footer-brand' href='{{ routes.root_url }}'>
        {{- settings.brand_label | default: shop.name | escape -}}
      </a>
      <p>{{ section.settings.text | escape }}</p>
      {% if settings.instagram != blank or settings.facebook != blank or settings.tiktok != blank or settings.youtube != blank %}
        <div class='footer-socials' aria-label='Social media'>
          {% if settings.instagram != blank %}
            <a href='{{ settings.instagram }}' target='_blank' rel='noopener noreferrer'>
              {% render 'social-icon', name: 'instagram' %}<span>Instagram</span>
            </a>
          {% endif %}
          {% if settings.facebook != blank %}
            <a href='{{ settings.facebook }}' target='_blank' rel='noopener noreferrer'>
              {% render 'social-icon', name: 'facebook' %}<span>Facebook</span>
            </a>
          {% endif %}
          {% if settings.tiktok != blank %}
            <a href='{{ settings.tiktok }}' target='_blank' rel='noopener noreferrer'>
              {% render 'social-icon', name: 'tiktok' %}<span>TikTok</span>
            </a>
          {% endif %}
          {% if settings.youtube != blank %}
            <a href='{{ settings.youtube }}' target='_blank' rel='noopener noreferrer'>
              {% render 'social-icon', name: 'youtube' %}<span>YouTube</span>
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>

    <nav class='footer-nav' aria-label='Shop'>
      <h2 class='eyebrow'>Shop</h2>
      <ul role='list'>
        <li><a href='{{ routes.all_products_collection_url }}'>All shoes</a></li>
        {% for collection in collections limit: 4 %}
          {% unless collection.handle == 'all' or collection.handle == 'frontpage' %}
            <li><a href='{{ collection.url }}'>{{ collection.title | escape }}</a></li>
          {% endunless %}
        {% endfor %}
      </ul>
    </nav>

    <nav class='footer-nav' aria-label='Help and information'>
      <h2 class='eyebrow'>Help</h2>
      <ul role='list'>
        {% if pages.contact != blank %}<li><a href='{{ pages.contact.url }}'>Contact</a></li>{% endif %}
        <li><a href='{{ routes.search_url }}'>Search</a></li>
        {% for blog_entry in blogs limit: 1 %}
          <li><a href='{{ blog_entry.url }}'>{{ blog_entry.title | escape }}</a></li>
        {% endfor %}
        {% if shop.customer_accounts_enabled %}
          <li><a href='{{ routes.account_url }}'>Account</a></li>
        {% endif %}
        <li><a href='{{ routes.cart_url }}'>Your bag</a></li>
      </ul>
    </nav>

    {% for block in section.blocks %}
      <nav class='footer-nav' aria-label='{{ block.settings.heading | escape }}' {{ block.shopify_attributes }}>
        <h2 class='eyebrow'>{{ block.settings.heading | escape }}</h2>
        {% render 'menu', menu: block.settings.menu %}
      </nav>
    {% endfor %}
  </div>

  <div class='footer-utility'>
    {% render 'localization', id: 'FooterLocalization' %}
    {% if section.settings.follow %}{{ shop | login_button: action: 'follow' }}{% endif %}
  </div>

  <div class='footer-bottom'>
    <small
      >© {{ 'now' | date: '%Y' }}
      {{ settings.brand_label | default: shop.name | escape -}}
    </small>
    <ul class='inline-list'>
      {% for policy in shop.policies -%}
        {%- if policy.body != blank %}
          <li><a href='{{ policy.url }}'>{{ policy.title | escape }}</a></li>
        {% endif -%}
      {%- endfor %}
    </ul>
    <ul class='payment-icons' role='list' aria-label='Accepted payment methods'>
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "Callout eyebrow",
      "default": "VANTA / New movement"
    },
    {
      "type": "text",
      "id": "cta_heading",
      "label": "Callout heading",
      "default": "Find your next move."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Callout button",
      "default": "Shop all shoes"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Independent footwear for everyday motion. Designed with intention, built to keep moving."
    },
    {
      "type": "checkbox",
      "id": "follow",
      "label": "Follow on Shop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Additional menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Footer menu",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}
