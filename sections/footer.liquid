<footer class='site-footer container section-space'>
  <div class='footer-top'>
    <div>
      <a class='footer-brand' href='{{ routes.root_url }}'>
        {{- settings.brand_label | default: shop.name | escape -}}
      </a>
      <p>{{ section.settings.text | escape }}</p>
      {% if settings.instagram -%}
        <a href='{{ settings.instagram }}'>Instagram ↗</a>
      {%- endif %}
      {% if settings.tiktok -%}
        <a href='{{ settings.tiktok }}'>TikTok ↗</a>
      {%- endif %}
    </div>
    {% for block in section.blocks %}
      <div {{ block.shopify_attributes }}>
        <h2 class='eyebrow'>{{ block.settings.heading | escape }}</h2>
        {% render 'menu', menu: block.settings.menu %}
      </div>
    {% endfor %}
  </div>
  {% render 'localization', id: 'FooterLocalization' %}
  <div class='footer-bottom'>
    <small
      >© {{ 'now' | date: '%Y' }}
      {{ settings.brand_label | default: shop.name | escape -}}
    </small>
    <ul class='inline-list'>
      {% for policy in shop.policies -%}
        {%- if policy.body != blank %}
          <li>
            <a href='{{ policy.url }}'>{{ policy.title | escape }}</a>
          </li>
        {% endif -%}
      {%- endfor %}
    </ul>
    <ul class='payment-icons' role='list'>
      {% for type in shop.enabled_payment_types %}
        <li>{{ type | payment_type_svg_tag }}</li>
      {% endfor %}
    </ul>
  </div>
  {% if section.settings.follow %}{{ shop | login_button: action: 'follow' }}{% endif %}
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Description",
      "default": "Engineered for movement. Designed for everywhere."
    },
    {
      "type": "checkbox",
      "id": "follow",
      "label": "Follow on Shop",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Explore"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ]
}
{% endschema %}
