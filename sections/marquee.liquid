<section class='marquee' aria-label='{{ section.settings.text | escape }}'>
  <div aria-hidden='true'>
    {% for i in (1..4) -%}
      <span>
        {{- section.settings.text | escape }}
        <b>↗</b></span
      >
    {%- endfor %}
  </div>
  <button
    type='button'
    class='marquee-pause'
    data-marquee-pause
    data-pause='{{ 'general.pause' | t }}'
    data-resume='{{ 'general.resume' | t }}'
  >
    {{ 'general.pause' | t }}
  </button>
</section>
{% schema %}
{
  "name": "Marquee",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Never stand still."
    }
  ],
  "presets": [
    {
      "name": "Marquee"
    }
  ]
}
{% endschema %}
