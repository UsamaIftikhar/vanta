<section
  class='marketing-section'
  style='--section-bg:{{ section.settings.background }};--section-fg:{{ section.settings.foreground }};--space:{{ section.settings.spacing }}px;--text-align:{{ section.settings.alignment }}'
>
  <div class='container'>
    <div class='section-heading' data-animate>
      <div>
        <p class='eyebrow'>{{ section.settings.eyebrow | escape }}</p>
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      <div class='rte'>{{ section.settings.text }}</div>
    </div>
    <div class='cinematic-video'>
      {% if section.settings.video -%}
        {{-
          section.settings.video
          | video_tag: controls: true, preload: 'none', image_size: '1600x'
        -}}
      {%- elsif section.settings.external -%}
        {%- if section.settings.external.type == 'youtube' -%}
          <iframe
            src='https://www.youtube-nocookie.com/embed/{{ section.settings.external.id }}'
            title='{{ section.settings.heading | escape }}'
            loading='lazy'
            allow='fullscreen'
            allowfullscreen
          ></iframe>
        {%- else -%}
          <iframe
            src='https://player.vimeo.com/video/{{ section.settings.external.id }}'
            title='{{ section.settings.heading | escape }}'
            loading='lazy'
            allow='fullscreen'
            allowfullscreen
          ></iframe>
        {%- endif -%}
      {%- else -%}
        {%- render 'image', image: section.settings.poster, demo: 'editorial' -%}
      {%- endif %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Cinematic video",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "VANTA Athletics"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for motion."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Engineered for movement. Designed for everywhere.</p>"
    },
    {
      "type": "color",
      "id": "background",
      "label": "Background",
      "default": "#101110"
    },
    {
      "type": "color",
      "id": "foreground",
      "label": "Text color",
      "default": "#f3f2ed"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 24,
      "max": 160,
      "step": 8,
      "unit": "px",
      "default": 96
    },
    {
      "type": "video",
      "id": "video",
      "label": "Shopify video"
    },
    {
      "type": "video_url",
      "id": "external",
      "label": "External video",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Poster"
    }
  ],
  "presets": [
    {
      "name": "Cinematic video"
    }
  ]
}
{% endschema %}
